# Copia este archivo a .env y rellena los valores reales.
# Las variables VITE_* quedan embebidas en el bundle del cliente:
# protégelas con restricciones en Google Cloud / Firebase, no esperes que sean secretas.

# Clave de Google Maps JS + Places (módulo de Restaurantes).
# Restríngela por referrer (HTTP) y por API en Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Firebase App Check (opcional, recomendado en producción)
VITE_FIREBASE_APPCHECK_SITE_KEY=
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Bootstrap del primer admin (legacy; las reglas ya no permiten bootstrap por cliente)
VITE_BOOTSTRAP_ADMIN_EMAILS=
